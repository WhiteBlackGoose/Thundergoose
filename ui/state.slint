export global Tip {
    in-out property <string> text;
    in-out property <length> x;
    in-out property <length> y;
    in-out property <bool> shown;
    public function show(t: string, px: length, py: length) {
        text = t;
        x = px;
        y = py;
        shown = true;
    }
    public function hide() {
        shown = false;
    }
}

/// One of your own addresses, as a small colored tag.
export struct AccountTag {
    label: string,
    color: color,
    addr: string,
}

export struct PeerItem {
    key: string,
    title: string,
    snippet: string,
    time: string,
    unread: int,
    initials: string,
    hue: color,
    group: bool,
    outgoing: bool,
    is-new: bool,
    favorite: bool,
    muted: bool,
    ignored: bool,
    /// Header shown above this row ("Favorites", "Chats").
    section: string,
    /// Website icon of the contact's organisation.
    icon: image,
    has-icon: bool,
    /// The "Yourself" conversation.
    me: bool,
    spam: bool,
    /// Your addresses this contact writes to, most recent first.
    accounts: [AccountTag],
}

export struct AttachmentItem {
    name: string,
    size: string,
    index: int,
    /// Decoded picture for image attachments.
    preview: image,
    has-preview: bool,
}

export struct MessageItem {
    id: int,
    outgoing: bool,
    sender: string,
    hue: color,
    show-sender: bool,
    subject: string,
    text: string,
    can-expand: bool,
    expanded: bool,
    time: string,
    full-time: string,
    day: string,
    via: string,
    via-color: color,
    /// Only in a Junk folder.
    junk: bool,
    loading: bool,
    has-html: bool,
    /// The HTML version, rendered; shown instead of the text when `html-on`.
    html: image,
    html-on: bool,
    /// Height of the rendering in CSS pixels (its width is 620).
    html-height: float,
    /// Remote images were left out.
    html-blocked: bool,
    /// Showing (or about to show) the formatted version rather than the text.
    html-formatted: bool,
    unread: bool,
    attachments: [AttachmentItem],
    /// Set when group mail shows up in a one-person conversation.
    group-label: string,
    group-key: string,
}

export struct AccountItem {
    id: string,
    email: string,
    label: string,
    hue: color,
    online: bool,
    busy: bool,
    needs-login: bool,
    oauth: bool,
    message: string,
    /// Name on the account's tags; `default-tag` when the user hasn't named it.
    tag: string,
    default-tag: string,
    /// Index into `App.tag-colors`, or -1 for the automatic color.
    tag-color: int,
}

export struct Participant {
    name: string,
    addr: string,
}

export global App {
    // Sidebar
    in property <[PeerItem]> peers;
    in property <int> selected: -1;
    in-out property <string> search;
    in property <[AccountItem]> accounts;
    in-out property <int> account-filter: -1;
    in property <bool> unread-only;
    in property <int> total-unread;
    in property <bool> syncing;
    in-out property <int> tab;
    in property <int> main-unread;
    in property <int> muted-unread;
    in property <int> muted-count;
    in property <int> ignored-count;
    in property <int> spam-count;
    in property <string> sync-text;

    // Conversation
    in property <bool> has-chat;
    in property <string> chat-title;
    in property <string> chat-subtitle;
    in property <string> chat-initials;
    in property <color> chat-hue;
    in property <bool> chat-group;
    in property <image> chat-icon;
    in property <bool> chat-has-icon;
    in property <bool> chat-me;
    in property <bool> chat-favorite;
    in property <bool> chat-muted;
    in property <bool> chat-ignored;
    in property <bool> chat-spam;
    in property <[AccountTag]> chat-accounts;
    in property <[Participant]> chat-people;
    in property <[MessageItem]> messages;
    in property <bool> has-earlier;
    in property <int> scroll-token;

    // Composer
    in-out property <string> draft-text;
    in-out property <string> draft-subject;
    in property <string> draft-from;
    in property <bool> draft-from-choosable;
    /// In the "Yourself" conversation: which own address the mail goes to.
    in property <bool> draft-self;
    in property <string> draft-to;
    in property <[string]> own-addresses;
    in property <[string]> draft-attachments;
    in property <bool> sending;
    in property <bool> new-chat;
    in-out property <string> new-chat-to;

    // Overlays
    in-out property <bool> settings-open;
    in-out property <bool> people-open;
    in property <string> toast;
    in property <bool> toast-error;
    in-out property <int> accent;
    in-out property <int> theme-mode;
    in property <string> profile-path;
    /// Contact names and renewed sign-ins keep coming from Thunderbird.
    in-out property <bool> tb-linked;
    in property <string> version;
    in-out property <bool> notify-desktop;
    in-out property <bool> notify-sound;
    in-out property <bool> show-favicons: true;
    in property <[color]> tag-colors;
    /// Index into the interface sizes 80, 90, 100, 110, 125, 150 %.
    in-out property <int> ui-scale: 2;

    // Account setup
    in-out property <bool> add-open;
    in-out property <int> add-step;
    in-out property <string> add-name;
    in-out property <string> add-email;
    in-out property <string> add-password;
    in-out property <string> add-username;
    in-out property <string> add-imap-host;
    in-out property <string> add-imap-port;
    in-out property <int> add-imap-sec;
    in-out property <string> add-smtp-host;
    in-out property <string> add-smtp-port;
    in-out property <int> add-smtp-sec;
    /// 0 password, 1 Google, 2 Microsoft
    in-out property <int> add-oauth;
    in property <bool> add-busy;
    in property <string> add-status;
    in property <bool> add-error;
    in-out property <string> tb-password;
    in-out property <string> confirm-remove;
    in-out property <bool> text-focus;

    callback select-peer(int);
    callback search-edited(string);
    callback search-accepted();
    callback filter(int);
    callback set-unread-only(bool);
    callback load-earlier();
    callback toggle-message(int);
    callback open-html(int);
    /// The link at CSS coordinates of a rendered mail, or "".
    pure callback link-at(int, float, float) -> string;
    pure callback short-url(string) -> string;
    callback open-link(string);
    /// Load remote images of a mail; `true`: always for its sender.
    callback load-images(int, bool);
    callback toggle-format(int);
    /// Interface size one step larger (1), smaller (-1) or back to 100 % (0).
    callback zoom(int);
    callback open-attachment(int, int);
    callback save-attachment(int, int);
    callback copy(string);
    callback send();
    callback attach();
    callback remove-attachment(int);
    callback choose-from(int);
    callback choose-to(int);
    callback start-new-chat();
    callback new-chat-confirm();
    callback cancel-new-chat();
    callback mark-unread();
    callback sync-now();
    callback sign-in(string);
    callback set-password(string, string);
    callback reimport();
    callback appearance-changed();
    callback dismiss-toast();
    callback write-to(string);
    callback set-tab(int);
    callback open-chat(string);
    /// Toggle favorite (0), muted (1), ignored (2) or spam (3) of the row at index, or of the open chat with -1.
    callback toggle-flag(int, int);
    callback mark-read-at(int);
    callback notify-changed();
    callback test-notification();
    callback tb-link-changed();
    callback add-detect();
    callback add-submit();
    callback remove-account(string);
    callback set-account-tag(string, string);
    /// Account id and palette index (-1: automatic).
    callback set-account-color(string, int);
}
